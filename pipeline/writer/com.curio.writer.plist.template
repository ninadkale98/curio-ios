<?xml version="1.0" encoding="UTF-8"?>
<!-- Template. Install to ~/Library/LaunchAgents/ (creds already live in
     pipeline/writer/.env.writer, so no secrets in this file), then:
       launchctl load ~/Library/LaunchAgents/com.curio.writer.plist
     Runs the dispatcher every 2h. Each tick spawns up to 5 writers in parallel:
     3 for today's fresh items, 2 draining the least-written backlog modalities
     (backlog capped ~30/day; fresh uncapped). -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.curio.writer</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/ninad/experiment/Curio_ios/Curio/pipeline/writer/run_dispatch.sh</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>StartInterval</key>
    <integer>1800</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/ninad/Library/Logs/curio-writer.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/ninad/Library/Logs/curio-writer.log</string>
</dict>
</plist>
