<?xml version="1.0" encoding="UTF-8"?>
<!-- LaunchDAEMON (system domain), not a LaunchAgent — the permanent fix for
     launchd silently deferring GUI-domain agents as "pended...speculative"
     when the session isn't a normal physical console login (observed on this
     box, which is driven via screen sharing). A system daemon runs whenever
     the machine is powered on, independent of any login/GUI session state.
     `claude`'s auth is a plain file (~/.claude/.credentials.json), not the
     keychain, so running as a daemon under UserName doesn't break auth.

     Install (needs sudo — root owns /Library/LaunchDaemons):
       sudo cp com.curio.writer.daemon.plist.template /Library/LaunchDaemons/com.curio.writer.plist
       sudo chown root:wheel /Library/LaunchDaemons/com.curio.writer.plist
       sudo chmod 644 /Library/LaunchDaemons/com.curio.writer.plist
       sudo launchctl bootstrap system /Library/LaunchDaemons/com.curio.writer.plist

     Then remove the old GUI LaunchAgent so both don't run:
       launchctl bootout gui/$(id -u)/com.curio.writer 2>/dev/null
       rm -f ~/Library/LaunchAgents/com.curio.writer.plist -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.curio.writer</string>
    <key>UserName</key>
    <string>ninad</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/ninad/experiment/Curio_ios/Curio/pipeline/writer/run_dispatch.sh</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/ninad</string>
    </dict>
    <key>StartInterval</key>
    <integer>7200</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/ninad/Library/Logs/curio-writer.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/ninad/Library/Logs/curio-writer.log</string>
</dict>
</plist>
